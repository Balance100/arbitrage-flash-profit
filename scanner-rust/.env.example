# Network RPCs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=

# --- Phase 3 live Arbitrum pool feed ---
# The live multi-DEX pool feed resolves an Arbitrum RPC in this priority order:
#   1. SCANNER_RPC_URL   (explicit full RPC URL, any provider)
#   2. ARBITRUM_RPC_URL  (per-network override above)
#   3. ALCHEMY_API_KEY / VITE_ALCHEMY_API_KEY -> https://arb-mainnet.g.alchemy.com/v2/<key>
# If none is set, the scanner logs a clear warning and falls back to SYNTHETIC
# demo pools (NOT live data). No key is ever hardcoded.
SCANNER_RPC_URL=
ALCHEMY_API_KEY=
# Pools whose USD liquidity is below this floor are treated as dust and skipped
# so stale/near-empty pools cannot manufacture fake spreads (default 5000). This
# is the BLUE-CHIP floor (applied to pools where both tokens are curated blue-chips).
SCANNER_MIN_POOL_LIQUIDITY_USD=5000

# --- Phase 9 long-tail universe expansion ---
# Higher USD liquidity floor for any pool touching a long-tail (non-blue-chip)
# token; long-tail prices are easier to manipulate and need more depth (default 25000).
SCANNER_MIN_LONGTAIL_POOL_LIQUIDITY_USD=25000
# Hard cap on the token universe (blue-chips always kept) to bound O(N^2) discovery.
SCANNER_MAX_TOKENS=64
# Hard cap on pools carried into edge-building/cross-tick fetch (deepest by USD kept).
SCANNER_MAX_POOLS=400
# A long-tail token's USD price must be corroborated by at least this many
# independent venue quotes agreeing within the outlier band, else it is dropped.
SCANNER_MIN_ANCHOR_VENUES=2
# Max % a venue's USD quote may deviate from the median before it is discarded.
SCANNER_ANCHOR_OUTLIER_PCT=3.0
# Max % a V2 pool's live balanceOf may fall below its stored reserve before the
# token is flagged non-standard (fee-on-transfer/rebasing) and dropped everywhere.
SCANNER_V2_BALANCE_TOLERANCE_PCT=1.0

# Contract addresses
FLASHLIGHT_CONTRACT_ADDRESS_ETHEREUM=0x0000000000000000000000000000000000000000
AAVE_POOL_ADDRESS_ETHEREUM=0x0000000000000000000000000000000000000000
FLASHLIGHT_CONTRACT_ADDRESS_ARBITRUM=
AAVE_POOL_ADDRESS_ARBITRUM=
FLASHLIGHT_CONTRACT_ADDRESS_BASE=
AAVE_POOL_ADDRESS_BASE=
FLASHLIGHT_CONTRACT_ADDRESS_POLYGON=
AAVE_POOL_ADDRESS_POLYGON=

# Signing
SCANNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
FLASHBOTS_SIGNER_PRIVATE_KEY=0xYOUR_FLASHBOTS_SIGNER_KEY
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_MAX_PRIORITY_FEE_GWEI=3
FLASHBOTS_FEE_MULTIPLIER=1.15

# Scanner behavior
SCANNER_LOAN_AMOUNT_USD=10000
SCANNER_MIN_NET_PROFIT_USD=14
SCANNER_MIN_SPREAD_PERCENT=0.075
SCANNER_MAX_SLIPPAGE_BPS=40
SCANNER_SCAN_INTERVAL_SECS=5
ENABLE_GRAPH_POLLING=true
ENABLE_RPC_FALLBACK=true
THEGRAPH_API_KEY=

# Logging and metrics
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_PROMETHEUS=true
PROMETHEUS_PORT=9090

# Telemetry
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_SUPABASE_TELEMETRY=false
